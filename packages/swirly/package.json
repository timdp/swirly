    "@swirly/theme-default-dark": "^0.22.0",
    "@swirly/theme-default-light": "^0.22.0",
    "@types/node": "^22.20.5",
    "js-yaml": "^5.5.0",
    "source-map-support": "^0.5.21",
    "svgo": "^4.1.0",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@swirly/types": "^0.22.0",
    "@types/yargs": "^17.0.35",
    "shx": "^0.4.0"
