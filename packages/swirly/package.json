{
  "name": "swirly",
  "version": "0.22.0",
  "description": "A marble diagram generator.",
  "homepage": "https://swirly.tmdpw.eu",
  "license": "MIT",
  "author": {
    "name": "Tim De Pauw",
    "url": "https://tmdpw.eu"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/timdp/swirly.git",
    "directory": "packages/swirly"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/timdp"
  },
  "bin": {
    "swirly": "dist/cli.js"
  },
