{
  "name": "@swirly/rasterization-server",
  "version": "0.21.0",
  "description": "Rasterization server for Swirly marble diagrams.",
  "license": "MIT",
  "repository": {
    "directory": "packages/swirly-rasterization-server",
    "type": "git",
